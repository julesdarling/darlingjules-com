---
import { withBasePath } from '../lib/paths';
import { siteName } from '../lib/seo';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const [firstName, lastName] = siteName.split(' ');

const navLinks = [
  { href: '/all-work', label: 'Work' },
  { href: '/about', label: 'About' },
  {
    href: 'https://www.linkedin.com/in/wetgirljpg/',
    label: 'LinkedIn',
    ariaLabel: 'Jules Darling on LinkedIn',
    external: true,
  },
  { href: 'mailto:hello@darlingjules.com', label: 'Contact', ariaLabel: `Email ${siteName}` },
];

const isExternal = (href: string) => /^https?:\/\//.test(href);
const isCurrent = (href: string) => !href.startsWith('mailto:') && !isExternal(href) && currentPath === href;
const hrefFor = (href: string) => (href.startsWith('mailto:') || isExternal(href) ? href : withBasePath(href));
---

<nav class="nav" aria-label="Primary">
  <span class="nav-hover-glow" aria-hidden="true"></span>
  <a
    href={hrefFor('/')}
    class:list={['logo', 'w-inline-block', { 'w--current': currentPath === '/' }]}
    aria-current={currentPath === '/' ? 'page' : undefined}
    aria-label={`${siteName} home`}
  >
    <span class="logo-wordmark">{firstName}</span>
    <img
      class="logo-mark"
      src={withBasePath('/assets/brand/jules-darling-mark.svg')}
      width="558"
      height="880"
      alt=""
      aria-hidden="true"
    />
    <span class="logo-wordmark">{lastName}</span>
  </a>
  <div class="div-block-29">
    {
      navLinks.map((link) => (
        <a
          href={hrefFor(link.href)}
          class:list={['navlink', { 'w--current': isCurrent(link.href) }]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          aria-label={link.ariaLabel}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          <span class="navlink-label">{link.label}</span>
        </a>
      ))
    }
  </div>
</nav>
