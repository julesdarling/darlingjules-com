---
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/400-italic.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import { absoluteSiteUrl, withBasePath } from '../lib/paths';
import { noindexPaths, productionOrigin, siteName } from '../lib/seo';
import '../styles/legacy.css';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  currentPath: string;
  ogImage?: string;
}

const {
  title,
  description = 'Jules Darling is a freelance creative director and designer in San Francisco working across brand, digital, motion, and launch systems.',
  bodyClass = '',
  currentPath,
  ogImage = '/assets/social-image.png',
} = Astro.props;

const canonicalPath = currentPath === '/' ? '' : currentPath;
const canonicalUrl = absoluteSiteUrl(canonicalPath, Astro.site ?? new URL(productionOrigin));
const pageTitle = title.includes('Darling') || title.length > 48 ? title : `${title} | ${siteName}`;
const absoluteOgImage = absoluteSiteUrl(ogImage, Astro.site ?? new URL(productionOrigin));
const robots = noindexPaths.has(currentPath) ? 'noindex, nofollow' : 'index, follow';
const showCopyrightFooter = true;
const normalizedDescription = description.replace(/\s+/g, ' ').trim();
const metaDescription =
  normalizedDescription.length <= 160
    ? normalizedDescription
    : `${normalizedDescription.slice(0, 157).replace(/\s+\S*$/, '')}...`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteName,
  url: absoluteSiteUrl('/', Astro.site ?? new URL(productionOrigin)),
  image: absoluteOgImage,
  jobTitle: 'Freelance creative director and designer',
  email: 'mailto:hello@darlingjules.com',
  description: metaDescription,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San Francisco',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  sameAs: ['https://www.linkedin.com/in/wetgirljpg/'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-M320J1PC7Z"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-M320J1PC7Z');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <link rel="icon" href={withBasePath('/assets/favicon.png?v=pink-heart')} type="image/png" />
    <link rel="shortcut icon" href={withBasePath('/assets/favicon.png?v=pink-heart')} type="image/png" />
    <link rel="apple-touch-icon" href={withBasePath('/assets/apple-touch-icon.png?v=pink-heart')} />
    <script is:inline>
      document.documentElement.classList.add('motion-ready');
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    <ClientRouter fallback="animate" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Nav currentPath={currentPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {
      showCopyrightFooter && (
        <footer class="site-copyright-footer" aria-label="Site copyright">
          <p>© 2026 Jules Darling · San Francisco, California</p>
        </footer>
      )
    }
    <script>
      import '../scripts/site-motion';
    </script>
  </body>
</html>
